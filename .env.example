# Copie este arquivo para .env e preencha os valores

# Chave secreta do Flask (gere uma com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Configurações do modelo
HALF_LIFE_DAYS=500
TRAIN_FROM=2018-01-01
DATA_MAX_AGE_HOURS=12

# Servidor
HOST=127.0.0.1
PORT=5000
THREADS=8

# Agente IA (opcional — o usuário pode fornecer via UI)
ANTHROPIC_API_KEY=
